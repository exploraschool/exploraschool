rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || request.auth.token.email == 'explora.sclub@gmail.com'
        );
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidLead() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'message'])
        && data.name is string
        && data.email is string
        && data.message is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.email.matches('.*@.*\\..*')
        && data.message.size() > 0
        && data.message.size() <= 5000
        && data.createdAt == request.time;
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && (
            resource.data.studentUid == request.auth.uid
            || resource.data.emailLower == request.auth.token.email
            || resource.data.email == request.auth.token.email
          )
        );
      allow create: if isValidLead();
      allow update, delete: if isAdmin();
    }

    match /progressReports/{reportId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
