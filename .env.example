# ── Site URL (production) ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.explora-school.es

# ── Google Search Console & Analytics (optional — add when you set them up) ──
# Search Console: HTML tag verification value (not the full meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Analytics: GA4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ETK2W2H0C6

# ── Firebase client (public — safe in browser) ───────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (Vercel server only — NEVER commit real values) ─────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Admin panel (Google Sign-In — only explora.sclub@gmail.com) ─────────────
# Enable Google provider in Firebase Console → Authentication → Sign-in method.
# Add authorized domains: localhost, explora-school.es, www.explora-school.es
# ADMIN_PASSWORD is no longer used.

# ── Booking confirmation links (Vercel — same value as in Firebase Functions) ─
LEAD_CONFIRM_SECRET=

# Optional: path to service-account JSON for local seed/upload scripts
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# ── Email (Vercel — Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=explora.sclub@gmail.com
RESEND_FROM=Explora School <onboarding@resend.dev>
